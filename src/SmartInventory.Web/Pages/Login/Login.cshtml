@page
@model SmartInventory.Web.Pages.Login.LoginModel
@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="lg-container">

    <h1 class="app-name">SmartInventory</h1>

    <form method="post">

        <h1>Login</h1>

        <label class="u-lbl">Username:</label>
        <input class="u-inp " type="text" asp-for="@Model.Details.Username" required/>
        <label class="p-lbl">Password:</label>
        <input class="p-inp" type="password" asp-for="@Model.Details.Password" required/>
        <button class="s-btn" type="submit" asp-page-handler="Login">Login</button>
    </form>
</div>

@if(Model.IsLoggedIn == "false"){

    <div class="status" style="display:block;background-color: red;">
        Failed!!!
    </div>
}
else if(Model.IsLoggedIn == "true"){
    <div class="status" style="display:block;background-color: green;">
        Success!!!
    </div>
}