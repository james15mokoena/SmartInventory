@page
@model SmartInventory.Web.Pages.Stock.RecordStockModel;

@{
    ViewData["Title"] = "Record Incoming Stock";
}

<link href="~/css/common.css" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/addproduct.css">
<link rel="stylesheet" href="~/css/record_stock.css">

<header>
        <h1 class="app-name">SmartInventory</h1>

        <!-- The navigation of the web page-->
        <ul class="admin-nav">
            <li><a class="nav-item active" href="~/Index">Home</a></li>
            <li><a class="nav-item" href="~/User/Index">User</a></li>
            <li><a class="nav-item" href="~/Supplier/Index">Supplier</a></li>
            <li><a class="nav-item" href="~/Stock/Index">Stock</a></li>
            <li><a class="nav-item" href="~/Sales/Index">Sales</a></li>
            <li><a class="nav-item" href="~/Product/Index">Product</a></li>
            <li><a class="nav-item" href="~/Procurement/Index">Procurement</a></li>
            <li><a class="nav-item" href="~/Permission/Index">Permission</a></li>
            <li><a class="nav-item" href="~/Login/Login">Login</a></li>
        </ul>

        <!-- The dropdown navigation to be shown on smaller screens -->
        <div class="dropdown">
            <img class="dropbtn" src="~/images/menu.png" alt="Menu" width="50px" height="40px">
            <div class="dropdown-content">
                <a class="nav-item active" href="~/Index">Home</a>
                <a class="nav-item" href="~/User/Index">User</a>
                <a class="nav-item" href="~/Supplier/Index">Supplier</a>
                <a class="nav-item" href="~/Stock/Index">Stock</a>
                <a class="nav-item" href="~/Sales/Index">Sales</a>
                <a class="nav-item" href="~/Product/Index">Product</a>
                <a class="nav-item" href="~/Procurement/Index">Procurement</a>
                <a class="nav-item" href="~/Permission/Index">Permission</a>
                <a class="nav-item" href="~/Login/Login">Login</a>
            </div>
        </div>
    </header>

     <div class="content">
        
        <h1>Record Stock</h1>

        <form method="post">

            <div class="row">
                <div class="col">
                    <label class="lbl" for="">SKU:</label>
                    <input class="inp" type="text" required asp-for="@Model.Transaction!.SKU">
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl" for="">Reason:</label>
                    <select id="select-reason" class="inp">
                        <option value=""></option>
                        <option value="Received">Received (purchased)</option>
                        <option value="Issued">Issued (sold)</option>
                        <option value="Damaged">Damaged (wasted)</option>
                        <option value="Returned">Returned (to supplier)</option>
                    </select>
                    <input type="text" hidden id="reason" asp-for="Transaction.TransactionReason">
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl" for="">Quantity:</label>
                    <input class="inp" type="number" min="0" required asp-for="@Model.Transaction!.Quantity">
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <button class="add-btn" type="submit" asp-page-handler="RecordStock">Record</button>
                </div>
            </div>

            @if(!string.IsNullOrEmpty(Model.IsRecorded) && Model.IsRecorded == "true"){
                <div class="status" style="color: green;display: block;">
                    Recorded!!!
                </div>
            }
            else if(Model.IsRecorded == "false"){
                <div class="status" style="color: red;display:block;">
                    Failed!!!
                </div>
            }

        </form>

    </div>

    <footer>
        Footer
    </footer>

</div>

<script type="text/javascript">
    
    const reasonSelector = document.querySelector("#select-reason");

    /**
        When user selects a reason option, set it as the transaction reason.
    */
    function reasonSelectorHandler(){
        document.querySelector("#reason").value = reasonSelector.value;
    }

    reasonSelector.addEventListener("change", reasonSelectorHandler);

</script>