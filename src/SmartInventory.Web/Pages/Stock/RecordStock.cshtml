@page
@model SmartInventory.Web.Pages.Stock.RecordStockModel;

@{
    ViewData["Title"] = "Record Incoming Stock";
}

<link href="~/css/layout.css" rel="stylesheet"/>
<link href="~/css/common.css" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/addproduct.css">
<link rel="stylesheet" href="~/css/record_stock.css">

<div class="container">
    
     <div class="content">
        
        <h1>Record Stock</h1>

        <form method="post">

            <div class="row">
                <div class="col">
                    <label class="lbl" for="">SKU:</label>
                    <input class="inp" type="text" required asp-for="@Model.Transaction!.SKU">
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl" for="">Reason:</label>
                    <select id="select-reason" class="inp">
                        <option value=""></option>
                        <option value="Received">Received (purchased)</option>
                        <option value="Issued">Issued (sold)</option>
                        <option value="Damaged">Damaged (wasted)</option>
                        <option value="Returned">Returned (to supplier)</option>
                    </select>
                    <input type="text" hidden id="reason" asp-for="Transaction.TransactionReason">
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl" for="">Quantity:</label>
                    <input class="inp" type="number" min="0" required asp-for="@Model.Transaction!.Quantity">
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <button class="add-btn" type="submit" asp-page-handler="RecordStock">Record</button>
                </div>
            </div>

            @if(!string.IsNullOrEmpty(Model.IsRecorded) && Model.IsRecorded == "true"){
                <div class="status" style="color: green;display: block;">
                    Recorded!!!
                </div>
            }
            else if(Model.IsRecorded == "false"){
                <div class="status" style="color: red;display:block;">
                    Failed!!!
                </div>
            }

        </form>

    </div>

</div>

<script type="text/javascript">
    
    const reasonSelector = document.querySelector("#select-reason");

    /**
        When user selects a reason option, set it as the transaction reason.
    */
    function reasonSelectorHandler(){
        document.querySelector("#reason").value = reasonSelector.value;
    }

    reasonSelector.addEventListener("change", reasonSelectorHandler);

</script>