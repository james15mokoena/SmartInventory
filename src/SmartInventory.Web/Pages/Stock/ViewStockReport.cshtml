@page
@using SmartInventory.Web.Models
@model SmartInventory.Web.Pages.Stock.ViewStockReportModel
@{
    ViewData["Title"] = "Stock Report";
}


<link href="~/css/common.css" rel="stylesheet"/>
<link href="~/css/stock_report.css" rel="stylesheet"/>

@*@if(!string.IsNullOrEmpty(Model.IsGenerated) && Model.IsGenerated == "true"){
    <script type="text/javascript">
        alert("Check your dowloads folder.");
    </script>
}
else{
    <script type="text/javascript">
        alert("Failed to generate the report!");
    </script>
}*@

<div class="container">

     <header>
        <h1 class="app-name">SmartInventory</h1>

        <!-- The navigation of the web page-->
        <ul class="admin-nav">
            <li><a class="nav-item active" href="~/Index">Home</a></li>
            <li><a class="nav-item" href="~/User/Index">User</a></li>
            <li><a class="nav-item" href="~/Supplier/Index">Supplier</a></li>
            <li><a class="nav-item" href="~/Stock/Index">Stock</a></li>
            <li><a class="nav-item" href="~/Sales/Index">Sales</a></li>
            <li><a class="nav-item" href="~/Product/Index">Product</a></li>
            <li><a class="nav-item" href="~/Procurement/Index">Procurement</a></li>
            <li><a class="nav-item" href="~/Permission/Index">Permission</a></li>
            <li><a class="nav-item" href="~/Login/Login">Login</a></li>
        </ul>

        <!-- The dropdown navigation to be shown on smaller screens -->
        <div class="dropdown">
            <img class="dropbtn" src="~/images/menu.png" alt="Menu" width="50px" height="40px">
            <div class="dropdown-content">
                <a class="nav-item active" href="~/Index">Home</a>
                <a class="nav-item" href="~/User/Index">User</a>
                <a class="nav-item" href="~/Supplier/Index">Supplier</a>
                <a class="nav-item" href="~/Stock/Index">Stock</a>
                <a class="nav-item" href="~/Sales/Index">Sales</a>
                <a class="nav-item" href="~/Product/Index">Product</a>
                <a class="nav-item" href="~/Procurement/Index">Procurement</a>
                <a class="nav-item" href="~/Permission/Index">Permission</a>
                <a class="nav-item" href="~/Login/Login">Login</a>
            </div>
        </div>
    </header>

     <div class="content">
        
        <h1>Stock Report</h1>

        <div class="report-container">

            <div class="company-name">
                <h2>@Model.StockReport!.CompanyName</h2>
            </div>

            <div class="doc-name">
                <h3>@Model.StockReport.DocName</h3>
            </div>

            <div class="tbl-container">

                <table class="tbl-stock">
                    <thead>
                        <tr>
                            <th style="border-left: none;">Item</th>
                            <th>Code</th>
                            <th>Stock Level <br /> (units)</th>
                            <th>Reorder Level <br /> (units)</th>
                            <th>Maximum Level <br /> (units)</th>
                            <th style="border-right: none;">Reorder? <br /> (Yes/No)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.StockReport.Items != null && Model.StockReport.Items.Count > 0){
                            List<StockReportItemDto> items = Model.StockReport.Items;
                            int numItems = 0;

                            foreach(StockReportItemDto item in items){
                                ++numItems;
                                if(numItems == items.Count){
                                    <tr>
                                        <td style="border-left: none;">@item.Name</td>
                                        <td>@item.Code</td>
                                        <td>@item.StockLevel</td>
                                        <td>@item.ReorderLevel</td>
                                        <td>@item.MaximumLevel</td>
                                        <td style="border-right: none;">@item.IsReorder</td>
                                    </tr>    
                                }
                                else{
                                    <tr>
                                        <td style="border-left: none;">@item.Name</td>
                                        <td>@item.Code</td>
                                        <td>@item.StockLevel</td>
                                        <td>@item.ReorderLevel</td>
                                        <td>@item.MaximumLevel</td>
                                        <td style="border-right: none;">@item.IsReorder</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>

             <div class="sig-date-container">
                <div class="sig-container">
                    <span class="sig-lbl">Signature:</span>
                    <span class="sig-val">@Model.StockReport.Signature</span>
                </div>
                <div class="date-container">
                    <span class="date-lbl">Date: </span>
                    <span class="date-val">@Model.StockReport.DateGenerated</span>
                </div>
            </div>
            
        </div>

    </div>

    <footer>
        Footer
    </footer>

</div>