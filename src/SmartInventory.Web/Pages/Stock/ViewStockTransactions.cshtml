@page
@using SmartInventory.Web.Models
@model SmartInventory.Web.Pages.Stock.ViewStockTransactionsModel;
@{
    ViewData["Title"] = "Stock Transactions";
}

<link href="~/css/layout.css" rel="stylesheet"/>
<link href="~/css/common.css" rel="stylesheet"/>
<link href="~/css/viewstocktransactions.css" rel="stylesheet"/>

<div class="container">
    
     <div class="content">
        
        <h1>View Stock Transactions</h1>

        <ul class="menu">
            <li class="menu-item">
                <button class="btn-all">
                    All
                </button>
            </li>
            <li class="menu-item">
                <button class="btn-issued">
                    Issued (Sold)
                </button>
            </li>
            <li class="menu-item">
                <button class="btn-received">
                    Received (Purchased)
                </button>
            </li>
            <li class="menu-item"> 
                <button class="btn-returned">
                    Returned
                </button>
            </li>
            <li class="menu-item">
                <button class="btn-damaged">
                    Damaged
                </button>
            </li>
            <li class="menu-item">
                <button class="btn-new-product">
                    New Product
                </button>
            </li>
        </ul>

        @if(Model.StockTransactions != null && Model.StockTransactions.Count > 0){            

            List<StockTransactionDto> transactions = Model.StockTransactions;

            <table class="tbl-stock">
                <thead>
                    <tr>
                        <th>Transaction Id</th>
                        <th>Product</th>
                        <th>Date</th>
                        <th>Previous Stock</th>
                        <th>New Stock</th>
                        <th>Reason</th>
                        <th>Initiator</th>
                    </tr>
                </thead>
                <tbody>             
                    @foreach(StockTransactionDto transaction in transactions){
                        <tr>
                            <td>@transaction.TransactionId</td>
                            <td>@transaction.ProductName</td>
                            <td>@transaction.Date</td>
                            <td>@transaction.PreviousStock</td>
                            <td>@transaction.NewStock</td>
                            <td>@transaction.Reason</td>
                            <td>@transaction.UserName</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if(@Model.IsFetched == "false" && @Model.StockTransactions.Count > 0){
                <a class="btn-more" style="display: none;" href="~/Stock/ViewStockTransactions">
                    Get More
                </a>
                <h3 style="color: green;">All transactions are displayed.</h3>
            }
            else{
                <a class="btn-more" href="~/Stock/ViewStockTransactions">
                    Get More
                </a>
            }     
        }
        else{
            <h3 style="color: red;">No transactions</h3>
        }

        @if(Model.IsFetched == "false" && @Model.StockTransactions!.Count == 0){
            <h3 style="color: red;">No transactions</h3>
        }  

    </div>

    <footer>
        Footer
    </footer>

</div>

<script type="text/javascript" src="~/js/view_stock_transactions.js"></script>