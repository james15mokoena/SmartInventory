@page
@using SmartInventory.Web.Models
@model SmartInventory.Web.Pages.Stock.TransactionReasonModel
@{
    ViewData["Title"] = "Transaction Reason Page";
}

<link href="~/css/common.css" rel="stylesheet"/>
<link href="~/css/transaction_reasons.css" rel="stylesheet"/>

<div class="container">

     <header>
        <h1 class="app-name">SmartInventory</h1>

        <!-- The navigation of the web page-->
        <ul class="admin-nav">
            <li><a class="nav-item active" href="~/Index">Home</a></li>
            <li><a class="nav-item" href="~/User/Index">User</a></li>
            <li><a class="nav-item" href="~/Supplier/Index">Supplier</a></li>
            <li><a class="nav-item" href="~/Stock/Index">Stock</a></li>
            <li><a class="nav-item" href="~/Sales/Index">Sales</a></li>
            <li><a class="nav-item" href="~/Product/Index">Product</a></li>
            <li><a class="nav-item" href="~/Procurement/Index">Procurement</a></li>
            <li><a class="nav-item" href="~/Permission/Index">Permission</a></li>
            <li><a class="nav-item" href="~/Login/Login">Login</a></li>
        </ul>

        <!-- The dropdown navigation to be shown on smaller screens -->
        <div class="dropdown">
            <img class="dropbtn" src="~/images/menu.png" alt="Menu" width="50px" height="40px">
            <div class="dropdown-content">
                <a class="nav-item active" href="~/Index">Home</a>
                <a class="nav-item" href="~/User/Index">User</a>
                <a class="nav-item" href="~/Supplier/Index">Supplier</a>
                <a class="nav-item" href="~/Stock/Index">Stock</a>
                <a class="nav-item" href="~/Sales/Index">Sales</a>
                <a class="nav-item" href="~/Product/Index">Product</a>
                <a class="nav-item" href="~/Procurement/Index">Procurement</a>
                <a class="nav-item" href="~/Permission/Index">Permission</a>
                <a class="nav-item" href="~/Login/Login">Login</a>
            </div>
        </div>
    </header>

     <div class="content">
        
        <h1>Transaction Reasons Management</h1>

        <ul class="options">
            <li class="add-reason"><button id="add-btn" href="">Add Transaction Reason</button></li>
            <li class="view-reasons"><button id="view-btn" href="">View Transaction Reasons</button></li>
        </ul>

        <!-- A tab for adding a transaction reason.-->
        <div class="add-reason-tab show">

            <h2 id="add-heading">Add Transaction Reason</h2>

            <form method="post">
                
                <div class="row">
                    <div class="col">
                        <label class="lbl">Reason:</label>
                        <input class="inp" type="text" required asp-for="@Model.TransactionReason!.Reason"/>
                    </div>
                </div>

                 <div class="row btn-row">
                    <div class="col btn-col">
                        <button class="add-btn" type="submit" asp-page-handler="AddReason">Add</button>
                    </div>
                </div>    
            </form>

            @if(Model.IsAdded == "false"){

                <div class="status" style="display:block;color: red;">
                    Failed!!!
                </div>
            }
            else if(Model.IsAdded == "true"){
                <div class="status" style="display:block;color: green;">
                    Added!!!
                </div>
            }

        </div>

        <!-- A tab for viewing transaction reasons -->
        <div class="view-reasons-tab">
            
            <h2 id="view-heading">View Transaction Reasons</h2>

            @{
                if(!string.IsNullOrEmpty(Model.IsFetched) && Model.IsFetched == "false"){

                    <div class="status" style="display: block;color:red;">
                        No transaction reasons!!
                    </div>
                }
                else if(!string.IsNullOrEmpty(Model.IsFetched) && Model.IsFetched == "true"){

                    <table class="tbl-reasons">
                        <thead>
                            <tr>
                                <th>Reason Id</th>
                                <th>Reason</th>
                                <th>Is Active</th>
                                <th>Edit Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                List<TransactionReasonDto> reasons = Model.TransactionReasons!;
                                
                                foreach(TransactionReasonDto reason in reasons){
                                    <tr>
                                        <td>@reason.Id</td>
                                        <td>@reason.Reason</td>
                                        <td>@reason.IsActive</td>
                                        <td>
                                            @if(reason.IsActive){
                                                <a class="lnk-activation" href="~/Stock/UpdateTransactionReason?reasonId=@reason.Id">Deactivate</a>
                                            }
                                            else{
                                                <a class="lnk-activation" href="~/Stock/UpdateTransactionReason?reasonId=@reason.Id">Activate</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            }

             @if(Model.IsUpdated == "false"){

                <div class="status" style="display:block;color: red;">
                    Failed to update the activation status.
                </div>
            }

        </div>
        
    </div>

    <footer>
        Footer
    </footer>

</div>

<script src="~/js/transaction_reasons.js" type="text/javascript"></script>