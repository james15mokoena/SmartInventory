@page
@model SmartInventory.Web.Pages.Product.AddProductModel

@{
    ViewData["Title"] = "Add Product";
}

<link href="~/css/common.css" rel="stylesheet"/>
<link href="~/css/addproduct.css" rel="stylesheet"/>

<div class="container">

     <header>
        <h1 class="app-name">SmartInventory</h1>

        <!-- The navigation of the web page-->
        <ul class="admin-nav">
            <li><a class="nav-item active" href="~/Index">Home</a></li>
            <li><a class="nav-item" href="~/User/Index">User</a></li>
            <li><a class="nav-item" href="~/Supplier/Index">Supplier</a></li>
            <li><a class="nav-item" href="~/Stock/Index">Stock</a></li>
            <li><a class="nav-item" href="~/Sales/Index">Sales</a></li>
            <li><a class="nav-item" href="~/Product/Index">Product</a></li>
            <li><a class="nav-item" href="~/Procurement/Index">Procurement</a></li>
            <li><a class="nav-item" href="~/Permission/Index">Permission</a></li>
            <li><a class="nav-item" href="~/Login/Login">Login</a></li>
        </ul>
    </header>

     <div class="content">
        
        <h1> Add New Product</h1>

        <form method="post">

            <div class="row">
                <div class="col">
                    <label class="lbl">Stock Keeping Unit (SKU):</label>
                    <input class="inp" type="text" asp-for="Product.SKU" required/>
                </div>
                <div class="col">
                    <label class="lbl">Name:</label>
                    <input class="inp" type="text" asp-for="Product.Name" required/>
                </div>
                <div class="col">
                    <label class="lbl">Description:</label>
                    <textarea class="inp" asp-for="Product.Description" required></textarea>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl">Category:</label>
                    <input class="inp" type="text" asp-for="Product.Category" required/>
                </div>
                <div class="col">
                    <label class="lbl">Unit Price (R):</label>
                    <input class="inp" type="number" min="0" asp-for="Product.UnitPrice" required/>
                </div>
                <div class="col">
                    <label class="lbl">Cost Price (R):</label>
                    <input class="inp" type="number" min="0" asp-for="Product.CostPrice" required/>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl">Current Stock:</label>
                    <input class="inp" type="number" min="0" asp-for="Product.CurrentStock" required/>
                </div>
                <div class="col">
                    <label class="lbl">Minimum Stock Level:</label>
                    <input class="inp" type="number" min="0" asp-for="Product.MinimumStockLevel" required/>
                </div>
                <div class="col">
                    <label class="lbl">Maximum Stock Level:</label>
                    <input class="inp" type="number" min="0" asp-for="Product.MaximumStockLevel" required/>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl">Reorder Quantity:</label>
                    <input class="inp" type="number" min="0" asp-for="Product.ReorderQuantity" required/>
                </div>
                <div class="col">
                    <label class="lbl">Barcode:</label>
                    <input class="inp" type="text" asp-for="Product.Barcode"/>
                </div>
                <div class="col">
                    <label class="lbl">Unit Measurement:</label>
                    <input class="inp" type="number" min="0" asp-for="Product.UnitMeasurement"/>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl">Image Url:</label>
                    <input class="inp" type="text" asp-for="Product.ImageUrl"/>
                </div>
                <div class="col">
                    <label class="lbl">Activate:</label>
                    <input class="inp" type="checkbox" asp-for="Product.IsActive" required/>
                </div>
                <div class="col">
                    <label class="lbl">Supplier Id:</label>
                    <input class="inp" type="number" min="0" asp-for="Product.SupplierId" required/>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <button class="add-btn" type="submit" asp-page-handler="AddProduct">Add</button>
                </div>
            </div>            
        </form>

        @if(Model.IsAdded == "false"){

            <div class="status" style="display:block;background-color: red;">
                Failed!!!
            </div>
        }
        else if(Model.IsAdded == "true"){
            <div class="status" style="display:block;background-color: green;">
                Added!!!
            </div>
        }
       
    </div>

    <footer>
        Footer
    </footer>

</div>