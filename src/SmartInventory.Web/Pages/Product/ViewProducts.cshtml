@page
@using SmartInventory.Web.Models
@model SmartInventory.Web.Pages.Product.ViewProductsModel
@{
    ViewData["Title"] = "View Products";
}

<link href="~/css/common.css" rel="stylesheet"/>
<link href="~/css/viewproducts.css" rel="stylesheet"/>

<div class="container">

     <div class="content">
        
        <h1>View Products</h1>

        <ul class="options">
            <li class="menu-option">
                <button class="btn-active-products">
                    Active Products
                </button>
            </li>
            <li class="menu-option">
                <button class="btn-deactivated-products">
                    Deactivated Products
                </button>
            </li>
            <li class="dropdown-prod menu-option">
                <span class="dropbtn-prod">Categories</span>
                <div class="dropdown-content-prod">
                    <a class="lnk lnk-hard-drives" href="~/Product/ViewProducts?type=Hard Drive">Hard Drives</a>
                    <a class="lnk lnk-monitors" href="~/Product/ViewProducts?type=Monitors">Monitors</a>
                    <a class="lnk lnk-keyboards" href="~/Product/ViewProducts?type=Keyboards">Keyboards</a>
                    <a class="lnk lnk-floppy-drives" href="~/Product/ViewProducts?type=Floppy Drive">Floppy Drives</a>
                    <a class="lnk lnk-kitchen-tools" href="~/Product/ViewProducts?type=Accessories">Accessories</a>
                    <a class="lnk lnk-computers" href="~/Product/ViewProducts?type=Computers">Computers</a>
                    <a class="lnk lnk-graphics" href="~/Product/ViewProducts?type=Graphics Cards">Graphics Cards</a>
                    <a class="lnk lnk-tools" href="~/Product/ViewProducts?type=Printers">Printers</a>
                    <a class="lnk lnk-games" href="~/Product/ViewProducts?type=Games">Games</a>
                    <a class="lnk lnk-games" href="~/Product/ViewProducts?type=CD Burners">CD Burners</a>
                    <a class="lnk lnk-games" href="~/Product/ViewProducts?type=CD Rom">CD Rom</a>
                </div>
            </li>
        </ul>

        <div class="products">

            @{
                List<ProductDto>? products = Model.Products;
                
                if(products != null && products.Count > 0){

                    foreach(ProductDto product in products){

                        <a href="~/Product/ProductDetails?sku=@product.SKU" class="product">
                            <img class="prod-img" src="~/images/@product.ImageUrl" alt="@product.Name">
                            <span>@product.Name</span>
                        </a>
                    }
                }
                else{
                    <p class="status">No products have been fetched!</p>
                }
            }
        </div>

    </div>

    <footer>
        Footer
    </footer>

</div>

<script type="text/javascript" src="~/js/view_products.js"></script>