@page
@model SmartInventory.Web.Pages.Product.ProductDetailsModel
@{
    ViewData["Title"] = "Product Details";
}

<link href="~/css/common.css" rel="stylesheet"/>
<link href="~/css/addproduct.css" rel="stylesheet"/>
<link href="~/css/editproduct.css" rel="stylesheet"/>
<link href="~/css/productdetails.css" rel="stylesheet"/>

<div class="container">

     <header>
        <h1 class="app-name">SmartInventory</h1>

        <!-- The navigation of the web page-->
        <ul class="admin-nav">
            <li><a class="nav-item active" href="~/Index">Home</a></li>
            <li><a class="nav-item" href="~/User/Index">User</a></li>
            <li><a class="nav-item" href="~/Supplier/Index">Supplier</a></li>
            <li><a class="nav-item" href="~/Stock/Index">Stock</a></li>
            <li><a class="nav-item" href="~/Sales/Index">Sales</a></li>
            <li><a class="nav-item" href="~/Product/Index">Product</a></li>
            <li><a class="nav-item" href="~/Procurement/Index">Procurement</a></li>
            <li><a class="nav-item" href="~/Permission/Index">Permission</a></li>
            <li><a class="nav-item" href="~/Login/Login">Login</a></li>
        </ul>

        <!-- The dropdown navigation to be shown on smaller screens -->
        <div class="dropdown">
            <img class="dropbtn" src="~/images/menu.png" alt="Menu" width="50px" height="40px">
            <div class="dropdown-content">
                <a class="nav-item active" href="~/Index">Home</a>
                <a class="nav-item" href="~/User/Index">User</a>
                <a class="nav-item" href="~/Supplier/Index">Supplier</a>
                <a class="nav-item" href="~/Stock/Index">Stock</a>
                <a class="nav-item" href="~/Sales/Index">Sales</a>
                <a class="nav-item" href="~/Product/Index">Product</a>
                <a class="nav-item" href="~/Procurement/Index">Procurement</a>
                <a class="nav-item" href="~/Permission/Index">Permission</a>
                <a class="nav-item" href="~/Login/Login">Login</a>
            </div>
        </div>
    </header>

     <div class="content">
        
        <h1>View Product Details</h1>

        <form method="post">

            <div class="row">
                <div class="col">
                    <label class="lbl">Stock Keeping Unit (SKU):</label>
                    <input class="inp" readonly type="text" value="@Model.Product!.SKU" asp-for="Product.SKU" />
                </div>
                <div class="col">
                    <label class="lbl">Name:</label>
                    <input class="inp" readonly type="text" value="@Model.Product.Name" asp-for="Product.Name" />
                </div>
                <div class="col">
                    <label class="lbl">Description:</label>
                    <input class="inp" readonly type="text" multiple value="@Model.Product.Description" asp-for="Product.Description"/>
                    @*@if(!string.IsNullOrEmpty(@Model.Product.Description)){
                        <textarea class="inp" asp-for="Product.Description">
                            @Model.Product.Description
                        </textarea>
                    }else{
                        <textarea class="inp" asp-for="Product.Description"></textarea>
                        
                    }*@
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl">Category:</label>
                    <input class="inp" readonly value="@Model.Product.Category" type="text" asp-for="Product.Category"/>
                </div>
                <div class="col">
                    <label class="lbl">Unit Price (R):</label>
                    <input class="inp" readonly value="@Model.Product.UnitPrice" type="number" min="0" asp-for="Product.UnitPrice"/>
                </div>
                <div class="col">
                    <label class="lbl">Cost Price (R):</label>
                    <input class="inp" readonly value="@Model.Product.CostPrice" type="number" min="0" asp-for="Product.CostPrice"/>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl">Current Stock:</label>
                    <input class="inp" readonly value="@Model.Product.CurrentStock" type="number" min="0" asp-for="Product.CurrentStock"/>
                </div>
                <div class="col">
                    <label class="lbl">Minimum Stock Level:</label>
                    <input class="inp" readonly value="@Model.Product.MinimumStockLevel" type="number" min="0" asp-for="Product.MinimumStockLevel"/>
                </div>
                <div class="col">
                    <label class="lbl">Maximum Stock Level:</label>
                    <input class="inp" readonly value="@Model.Product.MaximumStockLevel" type="number" min="0" asp-for="Product.MaximumStockLevel"/>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl">Reorder Quantity:</label>
                    <input class="inp" readonly value="@Model.Product.ReorderQuantity" type="number" min="0" asp-for="Product.ReorderQuantity"/>
                </div>
                <div class="col">
                    <label class="lbl">Barcode:</label>
                    <input class="inp" readonly value="@Model.Product.Barcode" type="text" asp-for="Product.Barcode"/>
                </div>
                <div class="col">
                    <label class="lbl">Unit Measurement:</label>
                    <input class="inp" readonly value="@Model.Product.UnitMeasurement" type="number" min="0" asp-for="Product.UnitMeasurement"/>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label class="lbl">Image Url:</label>
                    <input class="inp" readonly value="@Model.Product.ImageUrl" type="text" asp-for="Product.ImageUrl"/>
                </div>
                <div class="col">
                    <label class="lbl">Is Active:</label>
                    @if(Model.Product.IsActive){
                        <input class="inp" readonly type="checkbox" asp-for="Product.IsActive" checked />
                    }
                    else{
                        <input class="inp" readonly type="checkbox" asp-for="Product.IsActive" />
                    }
                </div>
                <div class="col">
                    <label class="lbl">Supplier:</label>
                    <input class="inp" readonly value="@Model.Product.SupplierName" type="text" asp-for="Product.SupplierName"/>
                </div>
            </div>

            <div class="row btn-row">
                <div class="col">
                    @if(Model.Product.IsActive == true){
                        <button class="edit-btn" type="submit" style="background-color: red;color:white;" asp-page-handler="ToggleActivation">
                            Deactivate
                        </button>
                    }
                    else{
                        <button class="edit-btn" type="submit" style="background-color: green;color:white 
                        "asp-page-handler="ToggleActivation">
                            Activate
                        </button>
                    }
                </div>
            </div>
        </form>

        @if(Model.IsEdited == "false"){

            <div class="status" style="display:block;color: red;">
                Failed!!!
            </div>
        }
        else if(Model.IsEdited == "true" && Model.Product!.IsActive){
            <div class="status" style="display:block;color: green;">
                Deactivated
            </div>
        }
        else if(Model.IsEdited == "true" && !Model.Product!.IsActive){
            <div class="status" style="display:block;color: green;">
                Activated
            </div>
        }
    </div>

    <footer>
        Footer
    </footer>

</div>