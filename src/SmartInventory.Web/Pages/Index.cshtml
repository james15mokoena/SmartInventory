@page
@using System.Text.Json
@model SmartInventory.Web.Pages.IndexModel

@{
    ViewData["Title"] = "Home page";
}

<link href="~/css/layout.css" rel="stylesheet"/>
<link href="~/css/index.css" rel="stylesheet"/>

<div class="container">

    <div class="content">
        
        <h1 class="home-heading">Dashboard</h1>

        <div class="home-menu">
            <button class="btn-item btn-sales-charts">Sales Reports</button>
            <button class="btn-item btn-purchases-charts">Purchases Reports</button>
            @*<button class="btn-item btn-returns-charts">Returns Reports</button>
            <button class="btn-item btn-damages-charts">Damages Reports</button>*@
        </div>

        <div class="month-selector">
            <button class="prev-month">&#60</button>
            <span class="selected-month">January</span>
            <button class="next-month">&#62</button>
        </div>

        @if(Model.IsFetched == "true"){

            <div class="charts">

                <div class="sales-reports show-reports-tab">

                    <h2 style="font-size: 40px;">Sales Reports</h2>

                    <div class="sales-charts all-charts-cnts">

                        <div class="revenue-chart-cnt inner-charts">
                            <canvas id="revenue-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the monthly revenue trends.
                                </div>
                            </div>
                        </div>

                        <div class="top-5-most-selling-categories-tm-chart-cnt inner-charts">                            
                            <canvas id="t5msctm-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the top 5 most selling product categories
                                    this month.
                                </div>
                            </div>
                        </div>

                        <div class="bottom-5-least-selling-categories-tm-chart-cnt inner-charts">                            
                            <canvas id="b5lsctm-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the bottom 5 least selling product categories
                                    this month.
                                </div>
                            </div>
                        </div>

                        <div class="categories-contributing-more-than-50-tm-chart-cnt inner-charts">
                            <canvas id="ccmt50tm-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the product categories contributing
                                    more than 50% towards the month's revenue.
                                </div>
                            </div>
                        </div>

                        <div class="categories-contributing-at-most-50-tm-chart-cnt inner-charts">
                            <canvas id="ccam50tm-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the product categories contributing
                                    at most 50% towards the month's revenue.
                                </div>
                            </div>                            
                        </div>

                        <div class="top-five-most-selling-products-in-month-chart-cnt inner-charts">
                            <canvas id="t5mspim-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the top five most selling products in the selected
                                    month.
                                </div>
                            </div>                            
                        </div>

                        <div class="five-least-selling-products-in-month-chart-cnt inner-charts">
                            <canvas id="fiveLeastSellingProductsInMonth-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the top five most selling products in the selected
                                    month.
                                </div>
                            </div>                            
                        </div>

                    </div>

                </div>

                <div class="purchases-reports hide-reports-tab">

                    <h2 style="font-size: 40px;">Purchases Reports</h2>

                    <div class="purchases-charts all-charts-cnts">

                        <div class="monthly-total-costs-chart-cnt inner-charts">
                            <canvas id="monthly-total-cost-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the monthly total cost trends.
                                </div>
                            </div>
                        </div>

                        <div class="top-5-categories-high-purchase-cost-tm-chart-cnt inner-charts">                            
                            <canvas id="t5cwhpc-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the top 5 categories with high purchase costs in the given month.
                                </div>
                            </div>
                        </div>

                        <div class="five-categories-low-purchase-cost-tm-chart-cnt inner-charts">                            
                            <canvas id="five-lcwlowpc-chart-canvas" class="chart"></canvas>
                            <div class="more-info">
                                <button class="btn-view-more-info">More Info</button>
                                <div class="info hide">
                                    Provides more insight/information regarding the five categories with low purchase costs in the given month.
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

                @*<div class="returns-reports hide-reports-tab">

                    <h2 style="font-size: 30px;">Returns Reports</h2>

                    <div class="returns-charts all-charts-cnts">
                        
                    </div>

                </div>

                <div class="damages-reports hide-reports-tab">

                    <h2 style="font-size: 30px;">Damages Reports</h2>

                    <div class="damages-charts all-charts-cnts">
                        
                    </div>
                </div>*@

            </div>
        }
        else if(Model.IsFetched == "false"){
            <h2 style="text-align: center;color:red;background-color: wheat;">
                No reports generated.
            </h2>
        }
    
    </div>

    <footer>
        Footer
    </footer>

</div>

<script src="~/lib/chartjs/chart.umd.min.js" type="text/javascript"></script>
<script src="~/js/index.js" type="text/javascript"></script>

@* ********************* CHART CREATION CODE ********************* *@
<script>

    @* $$$$$$$$$$ SALES REPORTS CHARTS $$$$$$$$$$*@

    /**
    * The "Monthly Revenue Trends" chart.
    */
    const revenueChartCanvasCtx = document.getElementById("revenue-chart-canvas").getContext("2d");
    let months = @Html.Raw(JsonSerializer.Serialize(Model.Months));
    let revenues = @Html.Raw(JsonSerializer.Serialize(Model.Revenues));

    const revenueChart = new Chart(revenueChartCanvasCtx, {
        type: 'line',
        data: {
            // x-axis
            labels: months,
            datasets: [
                {
                    label: 'Monthly Revenue Trends (R)',
                    data: revenues,
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                }
            },
            scales: {
                x: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Months',
                        font: {
                            size: 18
                        },
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                },
                y: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Revenue (R)',
                        font: {
                            size: 18
                        },
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                }
            }
        }
    });

    /**
        The "Top 5 Most Selling Categories in the selected month" chart.
    */
    const t5msctmChartCtx = document.querySelector("#t5msctm-chart-canvas").getContext("2d");
    let top5MostCategories = @Html.Raw(JsonSerializer.Serialize(Model.TopFiveCategories));
    let top5MostCategoriesSales = @Html.Raw(JsonSerializer.Serialize(Model.TopFiveCategoriesSales));

    const top5MostSellingCategoriesChart = new Chart(t5msctmChartCtx, {
        type: 'bar',
        data: {
            labels: top5MostCategories,
            datasets: [
                {
                    label: 'Top 5 Most Selling Categories',
                    data: top5MostCategoriesSales,
                    backgroundColor: ['green', 'lightblue', 'purple', 'maroon', 'orange'],
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                }
            },
            scales: {
                x: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Categories',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                },
                y: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Sales (R)',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                }
            }
        }
    });

    /**
        The "Bottom 5 Least Selling Categories in the selected month" chart.
    */
    const b5lsctmChartCtx = document.querySelector("#b5lsctm-chart-canvas").getContext("2d");
    let bottom5LeastCategories = @Html.Raw(JsonSerializer.Serialize(Model.BottomFiveCategories));
    let bottom5LeastCategoriesSales = @Html.Raw(JsonSerializer.Serialize(Model.BottomFiveCategoriesSales));

    const bottom5LeastSellingCategoriesChart = new Chart(b5lsctmChartCtx, {
        type: 'bar',
        data: {
            labels: bottom5LeastCategories,
            datasets: [
                {
                    label: 'Bottom 5 Least Selling Categories',
                    data: bottom5LeastCategoriesSales,
                    backgroundColor: ['green', 'lightblue', 'purple', 'maroon', 'orange'],
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                }
            },
            scales: {
                x: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Categories',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                },
                y: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Sales (R)',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                }
            }
        }
    });

    /*
        The "Categories Contributing More Than 50% Towards the selected Month's Revenue" chart.
    */
    const ccmt50Ctx = document.querySelector("#ccmt50tm-chart-canvas").getContext("2d");
    let categoriesCMT50 = @Html.Raw(JsonSerializer.Serialize(Model.CategoriesCMT50Percent));
    let contributingMT50Percent = @Html.Raw(JsonSerializer.Serialize(Model.ContributionsMT50Percent));

    const ccmt50Chart = new Chart(ccmt50Ctx, {
        type: 'pie',
        data: {
            labels: categoriesCMT50,
            datasets: [
                {
                    data: contributingMT50Percent
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                },
                title: {
                    display: true,
                    text: 'Categories Contributing More Than 50% Towards Revenue',
                    font: {
                        size: 18
                    }
                }
            }            
        }
    });

    /*
        The "Categories Contributing At Most 50% Towards the selected Month's Revenue" chart.
    */
    const ccam50Ctx = document.querySelector("#ccam50tm-chart-canvas").getContext("2d");
    let categoriesAM50Percent = @Html.Raw(JsonSerializer.Serialize(Model.CategoriesCAM50Percent));
    let contributingAM50Percent = @Html.Raw(JsonSerializer.Serialize(Model.ContributionsAM50Percent));

    const ccam50Chart = new Chart(ccam50Ctx, {
        type: 'pie',
        data: {
            labels: categoriesAM50Percent,
            datasets: [
                {
                    data: contributingAM50Percent
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                },
                title: {
                    display: true,
                    text: 'Categories Contributing At Most 50% Towards Revenue',
                    font: {
                        size: 18
                    }
                }
            }            
        }
    });

    /**
        The "Top 5 Most Selling Products in the selected month" chart.
    */
    const t5mspimChartCtx = document.querySelector("#t5mspim-chart-canvas").getContext("2d");
    let top5MostSellingProductNames = @Html.Raw(JsonSerializer.Serialize(Model.TopFiveMostSellingProductNames));
    let top5MostSellingProductSales = @Html.Raw(JsonSerializer.Serialize(Model.TopFiveMostSellingProductSales));

    const top5MostSellingProductsChart = new Chart(t5mspimChartCtx, {
        type: 'bar',
        data: {
            labels: top5MostSellingProductNames,
            datasets: [
                {
                    label: 'Top 5 Most Selling Products',
                    data: top5MostSellingProductSales,
                    backgroundColor: ['green', 'lightblue', 'purple', 'maroon', 'orange'],
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                }
            },
            scales: {
                x: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Product',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                },
                y: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Sales (R)',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                }
            }
        }
    });

    /**
        The "5 Least Selling Products in the selected month" chart.
    */
    const fiveLeastsellingProductsInMonthChartCtx = document.querySelector("#fiveLeastSellingProductsInMonth-chart-canvas").getContext("2d");
    let fiveLeastSellingProductNames = @Html.Raw(JsonSerializer.Serialize(Model.FiveLeastSellingProductNames));
    let fiveLeastSellingProductSales = @Html.Raw(JsonSerializer.Serialize(Model.FiveLeastSellingProductSales));

    const fiveLeastSellingProductsChart = new Chart(fiveLeastsellingProductsInMonthChartCtx, {
        type: 'bar',
        data: {
            labels: fiveLeastSellingProductNames,
            datasets: [
                {
                    label: 'Five Least Selling Products',
                    data: fiveLeastSellingProductSales,
                    backgroundColor: ['green', 'lightblue', 'purple', 'maroon', 'orange'],
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                }
            },
            scales: {
                x: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Product',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                },
                y: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Sales (R)',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                }
            }
        }
    });

    @* %%%%%%%%%% PURCHASES REPORTS CHARTS %%%%%%%%%%*@

    /**
    * The "Monthly Total Costs Trends" chart.
    */
    const totalCostsChartCanvasCtx = document.getElementById("monthly-total-cost-chart-canvas").getContext("2d");
    let monthsTC = @Html.Raw(JsonSerializer.Serialize(Model.MonthsTC));
    let totalCosts = @Html.Raw(JsonSerializer.Serialize(Model.TotalCosts));

    const totalCostsChart = new Chart(totalCostsChartCanvasCtx, {
        type: 'line',
        data: {
            // x-axis
            labels: monthsTC,
            datasets: [
                {
                    label: 'Monthly Total Costs Trends (R)',
                    data: totalCosts,
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                }
            },
            scales: {
                x: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Months',
                        font: {
                            size: 18
                        },
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                },
                y: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Total Cost (R)',
                        font: {
                            size: 18
                        },
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                }
            }
        }
    });

    /**
        The "Top 5 Categories with high purchase costs in the selected month" chart.
    */
    const topFiveCatWithHighPCChartCtx = document.querySelector("#t5cwhpc-chart-canvas").getContext("2d");
    let top5CatHighPCCategories = @Html.Raw(JsonSerializer.Serialize(Model.TopFiveCategoriesWithHighPurchaseCostsNames));
    let top5CatHighPCPurchases = @Html.Raw(JsonSerializer.Serialize(Model.TopFiveCategoriesWithHighPurchaseCostsTC));

    const top5CatHighPCChart = new Chart(topFiveCatWithHighPCChartCtx, {
        type: 'bar',
        data: {
            labels: top5CatHighPCCategories,
            datasets: [
                {
                    label: 'Top 5 Categories With High Purchase Cost',
                    data: top5CatHighPCPurchases,
                    backgroundColor: ['green', 'lightblue', 'purple', 'maroon', 'orange'],
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                }
            },
            scales: {
                x: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Categories',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                },
                y: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Cost (R)',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                }
            }
        }
    });

    /**
        The "5 Least Categories with low purchase cost in the selected month" chart.
    */
    const fiveLeastCatWithLowPCChartCtx = document.querySelector("#five-lcwlowpc-chart-canvas").getContext("2d");
    let fiveLeastPCCategories = @Html.Raw(JsonSerializer.Serialize(Model.FiveLeastCategoriesWithLowPurchaseCostsNames));
    let fiveLeastCategoriesPurchases = @Html.Raw(JsonSerializer.Serialize(Model.FiveLeastCategoriesWithLowPurchaseCostsTC));

    const fiveLeastCatWithLowPCChart = new Chart(fiveLeastCatWithLowPCChartCtx, {
        type: 'bar',
        data: {
            labels: fiveLeastPCCategories,
            datasets: [
                {
                    label: 'Five Least Categories with Low Purchase Cost',
                    data: fiveLeastCategoriesPurchases,
                    backgroundColor: ['green', 'lightblue', 'purple', 'maroon', 'orange'],
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 18
                        }
                    }
                }
            },
            scales: {
                x: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Categories',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                },
                y: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Cost (R)',
                        font: {
                            size: 18
                        }
                    },
                    ticks: {
                        font: {
                            size: 18
                        }
                    }
                }
            }
        }
    });

</script>