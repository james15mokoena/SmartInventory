<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartInventory.Web</title>
    <style type="text/css">
        html{
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            box-sizing: border-box;
            font-family: sans-serif;
            overflow: auto;
        }

        *, *::before, *::after{
            box-sizing: inherit;
        }
    </style>
</head>
<body>
     
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
