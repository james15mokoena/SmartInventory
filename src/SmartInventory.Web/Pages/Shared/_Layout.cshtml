@{
    string? currentPage = ViewContext.RouteData.Values["page"] as string ?? "/Index";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/layout.css" rel="stylesheet"/>
</head>
<body>
     
     <header>

        <h1 class="app-name">SmartInventory</h1>

        <!-- The navigation of the web page-->
        <ul class="admin-nav">
            <li><a class="nav-item home @(currentPage.StartsWith("/Index") == true ? "active" : "")" href="~/Index">Home</a></li>
            @*<li><a class="nav-item user @(currentPage.StartsWith("/User") == true ? "active" : "")" href="~/User/Index">User</a></li>
            <li><a class="nav-item supplier @(currentPage.StartsWith("/Supplier") == true ? "active" : "")" href="~/Supplier/Index">Supplier</a></li>*@
            <li><a class="nav-item stock @(currentPage.StartsWith("/Stock") == true ? "active" : "")" href="~/Stock/Index">Stock</a></li>
           @* <li><a class="nav-item sales @(currentPage.StartsWith("/Sales") == true ? "active" : "")" href="~/Sales/Index">Sales</a></li>*@
            <li><a class="nav-item product-link @(currentPage.StartsWith("/Product") == true ? "active" : "")" href="~/Product/Index">Product</a></li>
            @*<li><a class="nav-item procurement @(currentPage.StartsWith("/Procurement") == true ? "active" : "")" href="~/Procurement/Index">Procurement</a></li>
            <li><a class="nav-item permission @(currentPage.StartsWith("/Permission") ? "active" : "")" href="~/Permission/Index">Permission</a></li>*@
            @{
                if(!string.IsNullOrEmpty(TempData["Username"] as string)){
                    <li><a class="nav-item login @(currentPage.StartsWith("/Logout") ? "active" : "")" href="~/Login/Logout">Logout</a></li>
                    ViewData["Username"] = TempData["Username"];
                }
                else{
                    <li><a class="nav-item login @(currentPage.StartsWith("/Login") ? "active" : "")" href="~/Login/Login">Login</a></li>
                }
            }
            
        </ul>

        <!-- The dropdown navigation to be shown on smaller screens -->
        <div class="dropdown">
            <img class="dropbtn" src="~/images/menu.png" alt="Menu" width="50px" height="40px">
            <div class="dropdown-content">
                <a class="nav-item @(currentPage.StartsWith("/Index") == true ? "active" : "")" href="/Index">Home</a>
                @*<a class="nav-item @(currentPage.StartsWith("/User") == true ? "active" : "")" href="~/User/Index">User</a>
                <a class="nav-item @(currentPage.StartsWith("/Supplier") == true ? "active" : "")" href="~/Supplier/Index">Supplier</a>*@
                <a class="nav-item @(currentPage.StartsWith("/Stock") == true ? "active" : "")" href="~/Stock/Index">Stock</a>
                @*<a class="nav-item @(currentPage.StartsWith("/Sales") == true ? "active" : "")" href="~/Sales/Index">Sales</a>*@
                <a class="nav-item @(currentPage.StartsWith("/Product") == true ? "active" : "")" href="~/Product/Index">Product</a>
                @* <a class="nav-item @(currentPage.StartsWith("/Procurement") == true ? "active" : "")" href="~/Procurement/Index">Procurement</a>
                <a class="nav-item @(currentPage.StartsWith("/Permission") ? "active" : "")" href="~/Permission/Index">Permission</a>*@
                @if(!string.IsNullOrEmpty(TempData["Username"] as string)){
                    <a class="nav-item login @(currentPage.StartsWith("/Logout") ? "active" : "")" href="~/Login/Logout">Logout</a>
                    ViewData["Username"] = TempData["Username"];
                }
                else{
                    <a class="nav-item login @(currentPage.StartsWith("/Login") ? "active" : "")" href="~/Login/Login">Login</a>
                }
            </div>
        </div>

    </header>

    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        Footer
    </footer>

    <script type="text/javascript" src="~/js/layout.js"></script>
    
</body>
</html>
