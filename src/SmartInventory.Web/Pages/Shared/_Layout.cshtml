<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/layout.css" rel="stylesheet"/>
</head>
<body>
     
     <header>

        <h1 class="app-name">SmartInventory</h1>

        <!-- The navigation of the web page-->
        <ul class="admin-nav">
            <li><a class="nav-item home" href="~/Index">Home</a></li>
            <li><a class="nav-item user" href="~/User/Index">User</a></li>
            <li><a class="nav-item supplier" href="~/Supplier/Index">Supplier</a></li>
            <li><a class="nav-item stock" href="~/Stock/Index">Stock</a></li>
            <li><a class="nav-item sales" href="~/Sales/Index">Sales</a></li>
            <li><a class="nav-item product-lnk" href="~/Product/Index">Product</a></li>
            <li><a class="nav-item procurement" href="~/Procurement/Index">Procurement</a></li>
            <li><a class="nav-item permission" href="~/Permission/Index">Permission</a></li>
            <li><a class="nav-item login" href="~/Login/Login">Login</a></li>
        </ul>

        <!-- The dropdown navigation to be shown on smaller screens -->
        <div class="dropdown">
            <img class="dropbtn" src="~/images/menu.png" alt="Menu" width="50px" height="40px">
            <div class="dropdown-content">
                <a class="nav-item active" href="Index">Home</a>
                <a class="nav-item" href="~/User/Index">User</a>
                <a class="nav-item" href="~/Supplier/Index">Supplier</a>
                <a class="nav-item" href="~/Stock/Index">Stock</a>
                <a class="nav-item" href="~/Sales/Index">Sales</a>
                <a class="nav-item" href="~/Product/Index">Product</a>
                <a class="nav-item" href="~/Procurement/Index">Procurement</a>
                <a class="nav-item" href="~/Permission/Index">Permission</a>
                <a class="nav-item" href="~/Login/Login">Login</a>
            </div>
        </div>

    </header>

    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script type="text/javascript" src="~/js/layout.js"></script>
    
</body>
</html>
